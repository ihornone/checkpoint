---
import Layout from '@/layouts/Layout.astro';
import { Card, FoodPhoto, dishes } from '@/features/catalog';
import Icon from '@/shared/components/ui/Icon.astro';
import { Routes } from '@/shared/constants/routes';
import { PRICING_RULES } from '@/shared/constants/pricing';
import { BadgeCheck, Bike, Clock, ShieldCheck, Sparkles } from 'lucide-react';

export function getStaticPaths() {
  return dishes.map((dish) => ({ params: { slug: dish.slug }, props: { dish } }));
}

const { dish } = Astro.props;
const related = dishes.filter((item) => item.category === dish.category && item.slug !== dish.slug).slice(0, 4);

const pageTitle = `${dish.name} — доставка та замовлення у Львові`;
const pageDescription = `${dish.name} (${dish.portion}) за ціною ${dish.price} грн від CHECK POINT. ${dish.description} Гаряча доставка по Львову від 30 хв, безкоштовно від ${PRICING_RULES.FREE_DELIVERY_THRESHOLD} грн.`;

const dishSchema = {
  '@context': 'https://schema.org',
  '@type': 'MenuItem',
  name: dish.name,
  description: dish.description,
  image: `https://checkpoint.food/images/${dish.image}.webp`,
  offers: {
    '@type': 'Offer',
    price: dish.price,
    priceCurrency: 'UAH',
    availability: 'https://schema.org/InStock',
    url: `https://checkpoint.food/menu/${dish.slug}/`,
  },
  nutrition: {
    '@type': 'NutritionInformation',
    servingSize: dish.portion,
  },
};
---

<Layout title={pageTitle} description={pageDescription} schema={dishSchema}>
  <section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 sm:py-16 lg:px-12">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <FoodPhoto dish={dish} loading="eager" />
        <button
          class="favorite absolute right-0 top-0 grid size-12 place-items-center rounded-full bg-ink/80 text-white transition hover:text-brand [&.is-favorite]:text-brand"
          data-favorite={dish.slug}
          aria-label={`Додати в обране: ${dish.name}`}
          aria-pressed="false"
          type="button"
        >
          <Icon name="heart" size={26} />
        </button>
      </div>
      <div>
        <nav class="mb-4 flex items-center gap-2 text-xs font-bold text-white/50" aria-label="Хлібні крихти">
          <a href={Routes.HOME} class="hover:text-brand">Головна</a>
          <span>/</span>
          <a href={Routes.MENU} class="hover:text-brand">Меню</a>
          <span>/</span>
          <span class="text-brand">{dish.category}</span>
        </nav>
        <h1 class="mb-3 text-4xl font-black leading-tight text-paper sm:text-5xl lg:text-6xl">
          {dish.name} <span class="text-lg font-semibold text-brand sm:text-2xl">/ {dish.portion}</span>
        </h1>
        <p class="mb-6 text-base leading-7 text-white/75 sm:text-lg">{dish.description}</p>
        
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-white/50">Ціна порції</span>
            <b class="text-3xl font-black text-paper sm:text-4xl">{dish.price} <small class="text-base font-bold text-white/50">грн</small></b>
          </div>
          <button
            class="inline-flex min-h-12 items-center gap-3 rounded-xl bg-brand px-6 py-3 font-extrabold text-ink transition hover:scale-[1.02] hover:brightness-110"
            data-add={dish.slug}
            type="button"
          >
            Додати до кошика <Icon name="cart" size={21} />
          </button>
        </div>

        <div class="mb-6 grid grid-cols-2 gap-2 text-xs font-bold sm:grid-cols-3">
          <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.02] p-2.5 text-white/70">
            <Clock size={16} className="text-brand shrink-0" />
            <span>Доставка від 30 хв</span>
          </div>
          <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.02] p-2.5 text-white/70">
            <Bike size={16} className="text-brand shrink-0" />
            <span>0 грн від {PRICING_RULES.FREE_DELIVERY_THRESHOLD} грн</span>
          </div>
          <div class="col-span-2 flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.02] p-2.5 text-white/70 sm:col-span-1">
            <Sparkles size={16} className="text-brand shrink-0" />
            <span>−10% онлайн</span>
          </div>
        </div>

        <div class="divide-y divide-white/10 rounded-2xl border border-white/10 px-5">
          <details class="py-4" open>
            <summary class="cursor-pointer font-extrabold text-paper">Склад та інгредієнти</summary>
            <p class="mb-0 mt-3 text-sm leading-6 text-white/70">{dish.ingredients}.</p>
          </details>
          <details class="py-4">
            <summary class="cursor-pointer font-extrabold text-paper">Алергени та примітки</summary>
            <p class="mb-0 mt-3 text-sm leading-6 text-white/70">{dish.allergens}. На нашій кухні використовується спільне обладнання, тому можливий мінімальний перехресний контакт з іншими продуктами.</p>
          </details>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <a class="inline-flex items-center gap-2 text-sm font-bold text-brand transition hover:underline" href={Routes.DELIVERY}>
            <Icon name="scooter" size={20} /> Умови доставки та оплати →
          </a>
          <span class="text-xs text-white/45">Львів, вул. Київська, 36</span>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-20">
        <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
          <div>
            <h2 class="mb-1 text-3xl font-black text-paper sm:text-4xl">Спробуй також у категорії {dish.category}</h2>
            <p class="mb-0 text-sm text-white/60">Рекомендуємо доповнити замовлення цими стравами</p>
          </div>
          <a href={Routes.MENU} class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-white/20 px-5 font-bold text-white transition hover:border-brand hover:text-brand">Усе меню <Icon name="arrow" size={18} /></a>
        </div>
        <div class="cards-grid grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">{related.map((item) => <Card dish={item} />)}</div>
      </section>
    )}
  </section>
</Layout>
