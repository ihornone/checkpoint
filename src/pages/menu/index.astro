---
import Layout from '@/layouts/Layout.astro';
import { Card, Categories, FilterScript, dishes } from '@/features/catalog';
import Icon from '@/shared/components/ui/Icon.astro';
import { Routes } from '@/shared/constants/routes';
---

<Layout
  title="Меню страв та ціни — піца, бургери, салати, комбо у Львові"
  description="Повне онлайн-меню ресторану CHECK POINT у Львові: піца 32 см, соковиті крафтові бургери, закуски, свіжі салати та комбо. Доставка від 30 хв, безкоштовно від 300 грн, знижка 10% онлайн."
>
  <section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8 sm:py-16 lg:px-12">
    <div class="mb-8 max-w-3xl">
      <h1 class="text-4xl font-black leading-none text-paper sm:text-6xl lg:text-7xl">
        Меню страв <span class="ml-1 inline-block translate-y-[0.12em] text-brand">⤵</span>
      </h1>
      <p class="mt-4 text-base leading-7 text-white/75 sm:text-lg">
        Готуємо з-під ножа: 100% фермерська яловичина, 48-годинне тісто та натуральні соуси. Обирай улюблені смаки з доставкою від 30 хв або самовивозом зі знижкою 10%.
      </p>
    </div>

    <Categories all />

    <div class="my-8 flex flex-wrap items-center gap-3">
      <input
        class="min-h-12 min-w-[min(100%,18rem)] flex-1 rounded-xl border border-white/15 bg-white/[0.04] px-4 text-base text-white placeholder:text-white/40 focus:border-brand focus:outline-none"
        type="search"
        id="search"
        placeholder="Пошук страви (наприклад, пепероні, чедер, бургер)…"
        aria-label="Пошук страв за назвою"
      />
      <button
        class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-white/15 px-5 font-bold text-white/80 transition hover:border-brand hover:text-brand"
        id="favorites-filter"
        aria-pressed="false"
        type="button"
      >
        <Icon name="heart" size={19} /> Лише обране
      </button>
    </div>

    <div class="cards-grid filter-grid grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {dishes.map((dish) => <Card dish={dish} />)}
    </div>

    <div id="no-results" class="empty-results" hidden>
      <Icon name="pizza" size={50} />
      <h3>За твоїм запитом страв не знайдено</h3>
      <p>Спробуй змінити пошуковий запит, обрати іншу категорію або вимкнути фільтр «Лише обране».</p>
    </div>

    <aside class="mt-14 flex flex-col gap-5 rounded-3xl border border-brand/25 bg-brand/[0.06] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-9">
      <div class="max-w-xl">
        <h2 class="mb-2 text-2xl font-black text-paper sm:text-3xl">Замовляєш на компанію друзів чи колег?</h2>
        <p class="mb-0 text-sm leading-6 text-white/75 sm:text-base">Дві великі піци 32 см (Пепероні + Маргарита), дві порції хрусткої фрі та 1 літр цитрусового лимонаду — всього 699 грн замість 880 грн.</p>
      </div>
      <a class="inline-flex min-h-12 shrink-0 items-center justify-center gap-3 rounded-xl bg-brand px-6 py-3 font-extrabold text-ink transition hover:-translate-y-0.5 hover:brightness-110" href={Routes.MENU_ITEM('company-combo')}>
        Замовити комбо за 699 грн <Icon name="arrow" size={19} />
      </a>
    </aside>
  </section>
</Layout>
<FilterScript />
