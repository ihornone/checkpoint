---
import Layout from '@/layouts/Layout.astro';
import { Routes } from '@/shared/constants/routes';
---

<Layout title="Сторінку не знайдено">
  <section class="mx-auto flex min-h-[65vh] w-full max-w-7xl flex-col items-start justify-center px-5 py-20 sm:px-8 lg:px-12">
    <p class="mb-5 text-xs font-extrabold uppercase tracking-[0.25em] text-brand">404 / Тут нічого не подали</p>
    <h1 class="mb-6 max-w-4xl text-5xl font-black leading-[0.98] tracking-tight text-paper sm:text-7xl lg:text-8xl">
      Здається,<br />ти <span class="text-brand">зголоднів.</span>
    </h1>
    <p class="mb-8 max-w-xl text-lg text-white/70">Цієї сторінки немає. Зате в меню є щось смачне.</p>
    <a href={Routes.MENU} class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-6 py-3 font-extrabold text-ink transition hover:-translate-y-0.5 hover:brightness-110">
      Повернутися до меню ↗
    </a>
  </section>
</Layout>
