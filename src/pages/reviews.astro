---
import Layout from '@/layouts/Layout.astro';
import SocialLinks from '@/shared/components/layout/SocialLinks.astro';
import { ReviewCard, REVIEWS_DATA } from '@/features/reviews';
import {
  ArrowRight,
  Bike,
  Heart,
  MessageCircle,
  PencilLine,
  Sparkles,
  Star,
  Store,
  Utensils,
} from 'lucide-react';

const categories = [
  { id: 'all', label: 'Усі відгуки', icon: MessageCircle },
  { id: 'food', label: 'Смак страв', icon: Utensils },
  { id: 'delivery', label: 'Швидкість доставки', icon: Bike },
  { id: 'place', label: 'Заклад та атмосфера', icon: Store },
];

const reviewsSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'CHECK POINT',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'вул. Київська, 36',
    addressLocality: 'Львів',
    addressCountry: 'UA',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '142',
    bestRating: '5',
    worstRating: '1',
  },
  review: REVIEWS_DATA.map((item) => ({
    '@type': 'Review',
    author: {
      '@type': 'Person',
      name: item.name,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: '5',
    },
    reviewBody: item.text,
  })),
};
---

<Layout
  title="Відгуки гостей ресторану CHECK POINT у Львові"
  description="Реальні відгуки мешканців та гостей Львова про піцу, крафтові бургери та якість доставки CHECK POINT. Середня оцінка 4.9/5 на основі понад 10 000 замовлень."
  schema={reviewsSchema}
>
  <main class="mx-auto w-full max-w-7xl px-5 pb-12 sm:px-8 lg:px-12">
    <section class="grid items-center gap-8 py-12 sm:py-16 lg:min-h-[34rem] lg:grid-cols-2 lg:gap-12">
      <div>
        <h1 class="mb-5 text-4xl font-black leading-[0.98] tracking-tight text-paper sm:text-6xl lg:text-7xl">
          Відгуки<br />наших гостей<span class="text-brand">.</span>
        </h1>
        <p class="mb-7 max-w-lg text-lg leading-8 text-white/80 sm:text-xl">
          Чесні враження львів’ян про наші бургери, піцу на 48-годинному тісті, швидку доставку та сервіс на вул. Київській, 36.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="inline-flex min-h-12 items-center gap-3 rounded-xl bg-brand px-6 py-3 font-extrabold text-ink transition hover:brightness-110" href="#review-form">
            <PencilLine size={20} /> Залишити свій відгук <ArrowRight size={19} />
          </a>
          <a class="inline-flex min-h-12 items-center gap-3 rounded-xl border border-white/20 px-5 py-3 font-bold text-paper transition hover:border-brand hover:text-brand" href="#reviews">
            <Star size={20} /> Читати враження
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-3 -rotate-3 rounded-3xl border border-brand/45"></div>
        <img
          class="relative aspect-[4/3] w-full rotate-2 rounded-3xl object-cover"
          src="/images/about-interior.png"
          alt="Затишна зала ресторану CHECK POINT у Львові"
          fetchpriority="high"
          width="600"
          height="450"
        />
      </div>
    </section>

    <section class="grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label="Головні показники якості">
      <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
        <Star className="shrink-0 text-brand" size={27} strokeWidth={1.6} />
        <div>
          <b class="block text-sm text-paper">4.9 з 5.0</b>
          <span class="text-xs text-white/50">Середня оцінка</span>
        </div>
      </div>
      <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
        <Bike className="shrink-0 text-brand" size={27} strokeWidth={1.6} />
        <div>
          <b class="block text-sm text-paper">від 30 хв</b>
          <span class="text-xs text-white/50">Гаряча доставка</span>
        </div>
      </div>
      <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
        <Store className="shrink-0 text-brand" size={27} strokeWidth={1.6} />
        <div>
          <b class="block text-paper text-sm">Київська, 36</b>
          <span class="text-xs text-white/50">Локація у Львові</span>
        </div>
      </div>
      <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
        <Heart className="shrink-0 text-brand" size={27} strokeWidth={1.6} />
        <div>
          <b class="block text-sm text-paper">10 000+</b>
          <span class="text-xs text-white/50">Задоволених гостей</span>
        </div>
      </div>
    </section>

    <section class="py-14 sm:py-20" id="reviews">
      <div class="mb-6 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="mb-0 text-3xl font-black text-paper sm:text-4xl">Що кажуть гості CHECK POINT</h2>
        </div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Фільтр відгуків за категоріями">
          {categories.map(({ id, label, icon: CategoryIcon }, index) => (
            <button
              class:list={[
                'review-filter inline-flex min-h-11 items-center gap-2 rounded-xl border px-4 text-sm font-bold transition',
                index === 0
                  ? 'border-brand bg-brand text-ink'
                  : 'border-white/15 text-white/75 hover:border-brand hover:text-brand',
              ]}
              type="button"
              data-review-filter={id}
              aria-pressed={index === 0}
            >
              <CategoryIcon size={18} /> {label}
            </button>
          ))}
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {REVIEWS_DATA.map((review) => (
          <ReviewCard review={review} />
        ))}
      </div>

      <p class="mt-4 hidden rounded-2xl border border-white/10 p-6 text-center text-sm text-white/60" id="reviews-empty" role="status">У цій категорії поки немає відгуків.</p>
    </section>

    <section class="grid gap-8 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center" id="review-form">
      <div>
        <h2 class="mb-3 text-2xl font-black leading-tight text-paper sm:text-3xl">Поділися своїм враженням</h2>
        <div class="mb-4 flex items-center gap-3 text-brand">
          <MessageCircle size={24} strokeWidth={1.6} />
          <span class="text-sm font-bold text-white/75">Читаємо кожне повідомлення особисто</span>
        </div>
        <p class="mb-6 max-w-md text-sm leading-6 text-white/70">Що сподобалося найбільше: смак піци, соковитість бургерів чи швидкість кур’єра? Твій відгук допомагає нашій команді ставати кращими щодня.</p>
        <p class="mb-2 text-sm font-bold text-white/80">Також можна написати нам у соцмережах:</p>
        <SocialLinks />
      </div>

      <form id="review-form-fields" class="grid gap-4">
        <label class="grid gap-2 text-sm font-bold text-white/80">
          Твоє ім’я
          <input class="min-h-12 rounded-xl border border-white/15 bg-ink/60 px-4 text-base focus:border-brand focus:outline-none" name="name" required maxlength="60" placeholder="Як до тебе звертатися?" autocomplete="given-name" />
        </label>

        <fieldset>
          <legend class="mb-3 text-sm font-bold text-white/80">Твоя оцінка сервісу та їжі</legend>
          <div class="flex flex-wrap gap-2">
            {[5, 4, 3, 2, 1].map((rating) => (
              <label class="cursor-pointer">
                <input class="peer sr-only" type="radio" name="rating" value={rating} required checked={rating === 5} />
                <span class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-white/15 px-4 font-bold text-white/70 transition peer-checked:border-brand peer-checked:bg-brand/10 peer-checked:text-brand">
                  {rating} <Star size={15} />
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="grid gap-2 text-sm font-bold text-white/80">
          Твій відгук
          <textarea class="rounded-xl border border-white/15 bg-ink/60 p-4 text-base focus:border-brand focus:outline-none" name="message" required minlength="10" maxlength="1500" rows="4" placeholder="Розкажи детальніше: яка страва найбільше сподобалася, чи вчасно прибув кур'єр?"></textarea>
        </label>

        <button class="inline-flex min-h-12 items-center justify-center gap-3 rounded-xl bg-brand px-6 py-3 font-extrabold text-ink transition hover:brightness-110" type="submit">
          Надіслати відгук <ArrowRight size={19} />
        </button>
        <div id="review-result" class="text-sm leading-6 text-brand" role="status"></div>
      </form>
    </section>
  </main>
</Layout>

<script>
  const reviewFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-review-filter]'));
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('[data-review-category]'));
  const emptyState = document.querySelector<HTMLElement>('#reviews-empty');

  reviewFilters.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.dataset.reviewFilter;
      let visibleCount = 0;

      reviewFilters.forEach((filter) => {
        const selected = filter === button;
        filter.setAttribute('aria-pressed', String(selected));
        filter.classList.toggle('border-brand', selected);
        filter.classList.toggle('bg-brand', selected);
        filter.classList.toggle('text-ink', selected);
        filter.classList.toggle('border-white/15', !selected);
        filter.classList.toggle('text-white/75', !selected);
      });

      reviewCards.forEach((card) => {
        const visible = category === 'all' || card.dataset.reviewCategory === category;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
    });
  });

  const reviewForm = document.querySelector<HTMLFormElement>('#review-form-fields');
  const reviewResult = document.querySelector<HTMLElement>('#review-result');

  reviewForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (reviewResult) {
      reviewResult.textContent = 'Дякуємо за твій відгук! Ми перевіримо його перед публікацією на сайті.';
      reviewResult.className = 'text-sm leading-6 text-brand';
    }
    reviewForm.reset();
  });
</script>
