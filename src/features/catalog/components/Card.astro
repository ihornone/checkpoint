---
import type { Dish } from '../types/menu.types';
import FoodPhoto from './FoodPhoto.astro';
import Icon from '@/shared/components/ui/Icon.astro';
import { Routes } from '@/shared/constants/routes';

export interface Props {
  dish: Dish;
  class?: string;
}

const { dish, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'food-card group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition duration-200 hover:-translate-y-1 hover:border-brand/50',
    className,
  ]}
  data-category={dish.category}
  data-name={dish.name.toLowerCase()}
  data-id={dish.slug}
>
  <a class="food-photo block aspect-[4/3] overflow-hidden bg-white/[0.03]" href={Routes.MENU_ITEM(dish.slug)}>
    <FoodPhoto dish={dish} />
  </a>
  <button
    class="favorite absolute right-3 top-3 grid size-10 place-items-center rounded-full bg-ink/80 text-white transition hover:text-brand [&.is-favorite]:text-brand"
    data-favorite={dish.slug}
    aria-label={`В обране: ${dish.name}`}
    aria-pressed="false"
    type="button"
  >
    <Icon name="heart" size={21} />
  </button>
  <div class="card-content relative -mt-4 rounded-t-2xl bg-ink p-4 sm:p-5">
    <a class="dish-name block text-lg font-extrabold leading-tight text-paper transition group-hover:text-brand" href={Routes.MENU_ITEM(dish.slug)}>
      {dish.name}
    </a>
    <span class="portion mt-1 block text-sm text-white/50">{dish.portion}</span>
    <div class="food-bottom mt-4 flex items-center justify-between gap-3">
      <b class="text-xl font-black text-paper">{dish.price} <small class="text-sm font-bold text-white/50">грн</small></b>
      <button
        class="add grid size-11 shrink-0 place-items-center rounded-xl bg-brand text-ink transition hover:scale-105 hover:brightness-110"
        data-add={dish.slug}
        aria-label={`Додати ${dish.name} у кошик`}
        type="button"
      >
        <Icon name="cart" size={23} />
      </button>
    </div>
  </div>
</article>
