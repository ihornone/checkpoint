---
import { categories } from '../data/menu';
import Icon, { type IconName } from '@/shared/components/ui/Icon.astro';

export interface Props {
  all?: boolean;
  class?: string;
}

const { all = false, class: className = '' } = Astro.props;
---

<div class:list={['category-tabs grid grid-cols-2 gap-2 sm:grid-cols-3 lg:flex lg:flex-wrap lg:gap-3', className]} role="group" aria-label="Категорії меню">
  {all && (
    <button
      class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3 text-sm font-bold text-white/75 transition hover:border-white/20 hover:bg-white/[0.06] lg:min-h-11 lg:w-auto lg:px-5"
      data-filter="Усе меню"
      type="button"
    >
      <Icon name="bag" /> Усе меню
    </button>
  )}
  {categories.map((category, index) => (
    <button
      class:list={[
        'inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl border px-3 text-sm font-bold transition lg:min-h-11 lg:w-auto lg:px-5',
        index === 0 ? 'selected border-brand bg-brand/10 text-brand' : 'border-white/10 bg-white/[0.03] text-white/75 hover:border-white/20 hover:bg-white/[0.06]',
      ]}
      data-filter={category.name}
      aria-pressed={index === 0}
      type="button"
    >
      <Icon name={category.icon as IconName} /> {category.name}
    </button>
  ))}
</div>
