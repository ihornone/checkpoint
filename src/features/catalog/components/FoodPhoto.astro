---
import type { Dish } from '../types/menu.types';
import { getSpriteCoordinates, getSpriteIndex } from '@/shared/utils/sprite';

export interface Props {
  dish: Dish;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { dish, loading = 'lazy', class: customClass = '' } = Astro.props;
const index = getSpriteIndex(dish.slug);
const coords = getSpriteCoordinates(index);
const row = Math.floor(index / 4);
const spriteStyle = `--sprite-x: ${coords.x}; --sprite-y: ${coords.y};`;
---

{index >= 0 ? (
  <span
    class:list={['food-visual food-sprite aspect-[4/3] w-full', `sprite-row-${row}`, customClass]}
    role="img"
    aria-label={dish.name}
    style={spriteStyle}
  />
) : (
  <img
    class:list={['food-visual aspect-[4/3] w-full object-cover', customClass]}
    src={dish.imagePath}
    alt={dish.name}
    loading={loading}
    width="400"
    height="300"
  />
)}
