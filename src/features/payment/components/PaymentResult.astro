---
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
import { ArrowRight, CheckCircle, Clock, XCircle } from 'lucide-react';
import { Routes } from '@/shared/constants/routes';
import type { PaymentState } from '../types/payment.types';

export interface Props {
  state?: PaymentState;
}

const { state = 'pending' } = Astro.props;

const ICONS_STATIC = {
  pending: renderToStaticMarkup(createElement(Clock, { size: 34, strokeWidth: 1.6 })),
  success: renderToStaticMarkup(createElement(CheckCircle, { size: 34, strokeWidth: 1.8 })),
  failure: renderToStaticMarkup(createElement(XCircle, { size: 34, strokeWidth: 1.8 })),
};

const INITIAL_CONFIG = {
  pending: {
    classes: 'bg-white/5 text-white/40',
    title: 'Перевіряємо оплату…',
    text: 'Отримуємо підтвердження від банку. Зазвичай це займає кілька секунд. Будь ласка, не закривай сторінку.',
  },
  success: {
    classes: 'bg-brand/15 text-brand',
    title: 'Оплата успішна!',
    text: 'Дякуємо за замовлення! Оплату підтверджено. Наша кухня вже готує твої страви, а кур’єр готується вирушати.',
  },
  failure: {
    classes: 'bg-red-500/10 text-red-400',
    title: 'Оплату не завершено',
    text: 'Кошти з картки не списано. Можливо, закінчився інтернет-ліміт або виникла затримка банку. Спробуй ще раз у кошику.',
  },
} as const;

const initial = INITIAL_CONFIG[state];
---

<section
  class="grid gap-5 rounded-3xl border border-white/10 bg-white/[0.03] p-6 text-center sm:p-10"
  id="payment-result"
  data-state={state}
>
  <span
    class:list={['mx-auto grid size-16 place-items-center rounded-full transition-colors', initial.classes]}
    id="payment-icon"
    set:html={ICONS_STATIC[state]}
  />
  <h1 class="mb-0 text-3xl font-black text-paper" id="payment-title">{initial.title}</h1>
  <p class="mb-0 text-sm leading-6 text-white/60" id="payment-text">{initial.text}</p>
  <div class="text-sm text-white/50" id="payment-order"></div>
  <div class="flex flex-wrap justify-center gap-3 pt-2">
    <a
      href={Routes.MENU}
      class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand px-5 text-sm font-extrabold text-ink transition hover:-translate-y-0.5"
    >
      До меню <ArrowRight size={17} />
    </a>
    <a
      href={Routes.HOME}
      class="inline-flex min-h-11 items-center rounded-xl border border-white/15 px-5 text-sm font-bold text-paper transition hover:border-brand hover:text-brand"
    >
      На головну
    </a>
  </div>
</section>

<script>
  import { paymentApi } from '../api/paymentApi';
  import { STORAGE_KEYS } from '@/shared/constants/storage';
  import type { PaymentState } from '../types/payment.types';
  import type { StoredOrder } from '@/features/cart/types/cart.types';

  const ICONS = {
    pending:
      '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>',
    success:
      '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>',
    failure:
      '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>',
  };

  const STATES = {
    pending: { icon: 'pending', classes: 'bg-white/5 text-white/40', title: 'Перевіряємо оплату…' },
    success: { icon: 'success', classes: 'bg-brand/15 text-brand', title: 'Оплата успішна!' },
    failure: { icon: 'failure', classes: 'bg-red-500/10 text-red-400', title: 'Оплату не завершено' },
  } as const;

  const section = document.querySelector<HTMLElement>('#payment-result')!;
  const initialState = (section.dataset.state as PaymentState) || 'pending';
  const iconHolder = document.querySelector<HTMLElement>('#payment-icon')!;
  const title = document.querySelector<HTMLElement>('#payment-title')!;
  const text = document.querySelector<HTMLElement>('#payment-text')!;
  const orderContainer = document.querySelector<HTMLElement>('#payment-order')!;

  function render(state: PaymentState, message: string) {
    const config = STATES[state];
    iconHolder.className = `mx-auto grid size-16 place-items-center rounded-full transition-colors ${config.classes}`;
    iconHolder.innerHTML = ICONS[config.icon];
    title.textContent = config.title;
    text.textContent = message;
  }

  function displayStoredOrder(order: StoredOrder) {
    if (orderContainer) {
      orderContainer.innerHTML =
        `Замовлення на <b class="text-paper">${order.total} грн</b> · ${order.items.map((item) => `${item.name} ×${item.qty}`).join(', ')}`;
    }
  }

  function displayInvoiceSummary(invoiceId: string, amount?: number) {
    if (orderContainer && amount) {
      orderContainer.innerHTML = `Рахунок: <b class="text-paper">${invoiceId}</b> на суму <b class="text-paper">${(amount / 100).toFixed(0)} грн</b>`;
    }
  }

  const urlParams = new URLSearchParams(window.location.search);
  const queryInvoiceId = urlParams.get('invoiceId') || urlParams.get('id');

  let order: StoredOrder | null = null;
  try {
    const raw = localStorage.getItem(STORAGE_KEYS.LAST_ORDER);
    if (raw) order = JSON.parse(raw);
  } catch {
    order = null;
  }

  if (order) {
    displayStoredOrder(order);
  }

  const activeInvoiceId = queryInvoiceId || order?.invoiceId;

  // Handle explicit success route
  if (initialState === 'success') {
    const note = activeInvoiceId
      ? ` Рахунок ${activeInvoiceId}${order ? ` на ${order.total} грн` : ''}.`
      : '';
    render('success', `Дякуємо за замовлення! Оплату підтверджено.${note} Наша кухня вже готує твої страви, а кур’єр готується вирушати.`);
    localStorage.removeItem(STORAGE_KEYS.LAST_ORDER);
  }
  // Handle explicit failure route
  else if (initialState === 'failure') {
    const note = activeInvoiceId ? ` Рахунок ${activeInvoiceId}.` : '';
    render('failure', `Кошти з картки не списано.${note} Спробуй оформити замовлення ще раз або звернися до нас за телефоном.`);
  }
  // Handle pending verification route (/payment/)
  else {
    if (!activeInvoiceId) {
      render(
        'pending',
        'Не знайдено активного рахунку для перевірки. Якщо ти щойно оформив замовлення, перевір свій кошик.'
      );
    } else {
      let attempts = 0;
      const verifyStatus = async () => {
        attempts += 1;
        try {
          const data = await paymentApi.checkInvoiceStatus(activeInvoiceId);
          const status = data.status;

          if (data.amount && !order) {
            displayInvoiceSummary(activeInvoiceId, data.amount);
          }

          if (status === 'success') {
            clearInterval(timer);
            localStorage.removeItem(STORAGE_KEYS.LAST_ORDER);
            render(
              'success',
              `Дякуємо! Рахунок ${activeInvoiceId} успішно оплачено. Твої страви вже готуються на кухні!`
            );
          } else if (['failure', 'expired', 'reversed'].includes(status)) {
            clearInterval(timer);
            render(
              'failure',
              `Рахунок ${activeInvoiceId} отримав статус «${status}». Кошти не списано — спробуй оформити замовлення знову.`
            );
          } else if (attempts > 36) {
            clearInterval(timer);
            render(
              'pending',
              `Рахунок ${activeInvoiceId} ще обробляється банком. Будь ласка, онови сторінку за кілька хвилин або зв'яжися з нами.`
            );
          }
        } catch (err) {
          if (attempts > 6) {
            clearInterval(timer);
            render(
              'failure',
              'Не вдалося автоматично перевірити статус оплати через мережу. Будь ласка, онови сторінку.'
            );
          }
        }
      };

      // Check immediately, then poll
      verifyStatus();
      const timer = setInterval(verifyStatus, 2500);
    }
  }
</script>
