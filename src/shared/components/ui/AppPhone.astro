---
export interface Props {
  class?: string;
  className?: string;
  loading?: 'lazy' | 'eager';
}

const { class: className = '', loading = 'lazy' } = Astro.props;
---

<img
  class:list={['object-contain', className]}
  src="/images/app-phone-food.png"
  alt="Застосунок CHECK POINT для замовлення їжі"
  loading={loading}
  width="420"
  height="840"
/>
