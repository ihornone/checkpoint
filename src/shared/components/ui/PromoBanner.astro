---
import { ArrowRight } from 'lucide-react';
import { Routes } from '@/shared/constants/routes';
import { PRICING_RULES } from '@/shared/constants/pricing';

export interface Props {
  class?: string;
  href?: string;
  discountPercent?: number;
}

const {
  class: className = '',
  href = Routes.MENU,
  discountPercent = PRICING_RULES.ONLINE_DISCOUNT_PERCENT,
} = Astro.props;
---

<a
  class:list={[
    'group relative flex min-h-40 items-center overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] px-6 py-8 transition hover:border-brand/40 sm:px-9 lg:min-h-48',
    className,
  ]}
  href={href}
>
  <div class="relative z-10">
    <h2 class="mb-0 text-xl font-black leading-tight text-paper sm:text-3xl">
      Замовляй через нашу сторінку та отримай <em class="not-italic text-brand">знижку {discountPercent}%</em>
    </h2>
  </div>
  <span
    class="ml-auto hidden size-12 shrink-0 place-items-center rounded-xl border-2 border-white text-paper transition group-hover:border-brand group-hover:bg-brand group-hover:text-ink sm:grid sm:size-14"
    aria-hidden="true"
  >
    <ArrowRight size={26} />
  </span>
</a>
